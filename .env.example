# Optional: set an OpenAI key when using the real AI integration
OPENAI_API_KEY=your-openai-api-key

# Local database configuration
# SQLite keeps local development independent from Docker and MySQL.
DATABASE_URL=sqlite:///./backend/event_management.db

# Optional MySQL configuration for Docker/deployment
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=event_management
MYSQL_USER=event_user
MYSQL_PASSWORD=event_password
MYSQL_ROOT_PASSWORD=root_password

# Local JWT configuration
JWT_SECRET_KEY=dev-only-change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
